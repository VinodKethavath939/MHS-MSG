SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Use SQLite only for a small private deployment. For a VPS/shared deployment,
# set DATABASE_URL to a PostgreSQL connection string instead.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

CHROME_DRIVER_PATH=C:/path/to/chromedriver.exe
WHATSAPP_MESSAGE_DELAY=2
WHATSAPP_TIMEOUT=60
WHATSAPP_SESSION_TIMEOUT=300

# Enable these only when your site is served through HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
